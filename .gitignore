# Ignorar la carpeta node_modules dentro de front
front/node_modules/

# Ignorar archivos y directorios específicos dentro de front
front/.pnp
front/.pnp.js

# Ignorar carpetas relacionadas con testing en front
front/coverage/

# Ignorar carpetas relacionadas con producción en front
front/build/

# Ignorar archivos y directorios generales
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignorar archivos de logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# Carptea Back (Servidor)
# Dependencias de Node.js
back/node_modules/

# Archivos de entorno
back/.env

# Archivos de log
back/*.log

# Archivos temporales
back/*.tmp
back/*.swp

# Directorios de compilación
back/dist/
back/build/

# Archivos específicos del entorno de desarrollo
back/.vscode/
back/.idea/
back/*.sublime-project
back/*.sublime-workspace

# Archivos generados por el sistema operativo
back.DS_Store
back/Thumbs.db

# Otros archivos específicos del entorno
back/npm-debug.log*
back/yarn-debug.log*
back/yarn-error.log*
